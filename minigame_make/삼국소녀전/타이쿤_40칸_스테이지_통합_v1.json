        "label": "타이쿤 이벤트 1 설정",
        "entityKey": "tycoon_event_1",
        "attributes": [
          { "key": "init_dice", "type": "number", "value": "1000" },
          { "key": "dice_multiplier", "type": "number", "value": "10" },
          { "key": "minigame_1_weight", "type": "number", "value": "70" }
        ]
      }
    },
    {
      "id": "node-entity-board-stage",
      "type": "entity",
      "position": { "x": -300, "y": 600 },
      "data": {
        "label": "스테이지 정보",
