        "resourceKey": "money"
      }
    },
    {
      "id": "n-simulation-end",
      "type": "success",
      "position": { "x": 700, "y": 150 },
      "data": {
        "label": "시뮬레이션 종료",
        "description": "주사위 모두 소모됨"
      }
    },
    {
      "id": "node-entity-tycoon-event-1",
      "type": "entity",
