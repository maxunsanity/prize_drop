        "attributes": [
          { "key": "pos_old", "type": "number", "value": "pos" },
          { "key": "pos", "type": "number", "value": "(pos + roll) % 40" }
        ]
      }
    },
    {
      "id": "n-lap-check",
      "type": "gate",
      "position": { "x": 400, "y": 650 },
      "data": {
