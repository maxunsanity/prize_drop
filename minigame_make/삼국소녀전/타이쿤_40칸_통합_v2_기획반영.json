      "type": "trigger",
      "position": { "x": 400, "y": 450 },
      "data": {
        "label": "주사위 굴리기 (2d6)",
        "attributes": [
          { "key": "roll", "type": "number", "value": "rand.d6() + rand.d6()" },
          { "key": "dice", "type": "number", "value": "dice - dice_count" },
          { "key": "point_gain", "type": "number", "value": "0" }
        ]
      }
    },
    {
      "id": "n-move-logic",
      "type": "trigger",
