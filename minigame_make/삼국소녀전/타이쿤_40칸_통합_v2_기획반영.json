    },
    {
      "id": "n-init",
      "type": "trigger",
      "position": { "x": 0, "y": 150 },
      "data": {
        "label": "시뮬레이션 초기화",
        "attributes": [
          { "key": "dice", "type": "number", "value": "tycoon_event_1.init_dice" },
          { "key": "dice_count", "type": "number", "value": "tycoon_event_1.dice_multiplier" },
          { "key": "pos", "type": "number", "value": "0" },
          { "key": "pos_old", "type": "number", "value": "0" },
          { "key": "money", "type": "number", "value": "1000" },
          { "key": "point_gain", "type": "number", "value": "0" },
          { "key": "lap_count", "type": "number", "value": "0" },
          { "key": "roll", "type": "number", "value": "0" }
