        "description": "돈(money) 자원으로 시작"
      }
    },
    {
      "id": "n-loop-gate",
      "type": "gate",
      "position": { "x": 400, "y": 150 },
      "data": {
        "label": "주사위 체크",
        "condition": "dice >= dice_count"
      }
    },
    {
      "id": "n-consume-dice",
      "type": "disposal",
      "position": { "x": 400, "y": 300 },
