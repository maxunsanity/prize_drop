  "nodes": [
    {
      "id": "n-entry",
      "type": "entry",
      "position": { "x": 0, "y": 0 },
      "data": { "label": "시즌 시작" }
    },
    {
      "id": "n-init",
      "type": "trigger",
      "position": { "x": 0, "y": 150 },
      "data": {
        "label": "실제 데이터 초기화",
        "attributes": [
          { "key": "dice", "type": "number", "value": "1000" },
          { "key": "dice_count", "type": "number", "value": "10" },
          { "key": "pos", "type": "number", "value": "0" },
          { "key": "pos_old", "type": "number", "value": "0" },
          { "key": "money", "type": "number", "value": "1000000" },
          { "key": "point_gain", "type": "number", "value": "0" },
          { "key": "roll", "type": "number", "value": "0" }
        ],
        "description": "한양 스테이지 기준 100만 Money로 시작"
      }
    },
    {
      "id": "n-loop-gate",
      "type": "gate",
      "position": { "x": 400, "y": 150 },
      "data": { "label": "주사위 체크", "condition": "dice >= dice_count" }
    },
    {
      "id": "n-consume-dice",
      "type": "disposal",
      "position": { "x": 400, "y": 300 },
      "data": { "label": "주사위 소비" }
    },
    {
      "id": "n-roll",
      "type": "trigger",
      "position": { "x": 400, "y": 450 },
      "data": {
        "label": "2d6 굴리기",
        "attributes": [
          { "key": "roll", "type": "number", "value": "rand.d6() + rand.d6()" },
          { "key": "dice", "type": "number", "value": "dice - dice_count" },
          { "key": "point_gain", "type": "number", "value": "0" }
        ]
      }
    },
    {
      "id": "n-move-logic",
      "type": "trigger",
      "position": { "x": 400, "y": 550 },
      "data": {
        "label": "이동 처리",
        "attributes": [
          { "key": "pos_old", "type": "number", "value": "pos" },
          { "key": "pos", "type": "number", "value": "(pos + roll) % 40" }
        ]
      }
    },
    {
      "id": "n-lap-check",
      "type": "gate",
      "position": { "x": 400, "y": 650 },
      "data": { "label": "GO 통과?", "condition": "pos < pos_old" }
    },
    {
      "id": "n-pass-go",
      "type": "trigger",
      "position": { "x": 700, "y": 650 },
      "data": {
        "label": "GO 보상 (200)",
        "attributes": [ { "key": "point_gain", "type": "number", "value": "200 * board_stage.reward_scale * dice_count" } ]
      }
    },
    {
      "id": "n-accumulate-go",
      "type": "reward",
      "position": { "x": 900, "y": 650 },
      "data": { "label": "통과 보상 누적" }
    },
    {
